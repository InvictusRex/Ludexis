# Folder on this machine that holds your games; mounted read-only at /games.
GAMES_PATH=/mnt/games

# Port the web UI is served on.
LUDEXIS_PORT=8420

# Optional HTTPS: a domain name that points at this host. Caddy then gets a certificate for it automatically;
# set LUDEXIS_PORT=80 and LUDEXIS_HTTPS_PORT=443 so the certificate authority can reach it.
# Recommended before exposing Ludexis outside your home network.
LUDEXIS_DOMAIN=
LUDEXIS_HTTPS_PORT=8443

# Time zone for scheduled tasks (nightly scan at 02:00 local time by default).
TZ=UTC

# Database password, used only inside the stack.
POSTGRES_PASSWORD=change-me

# Optional: IGDB credentials from https://dev.twitch.tv/console. They can also be entered in the web UI.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
